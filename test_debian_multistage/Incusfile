# Debian 多阶段构建 - Go 编译 + 运行时
# 测试点：多 FROM (FROM...AS + 第二个 FROM)、COPY --from=<阶段名>、WORKDIR、ENV、幂等重建
# 测试命令：curl http://debian-go.test/health
#           curl http://debian-go.test/api/time
FROM debian/13 AS builder

RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n' > /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends golang-go ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /src

ENV GOPROXY=https://goproxy.cn
ENV GOSUMDB=off
ENV CGO_ENABLED=0

COPY ./main.go ./
COPY ./go.mod ./
RUN go build -trimpath -ldflags '-s -w' -o webapp .

# === 第二阶段: 运行时 ===
FROM debian/13
NAME debian-go

RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n' > /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl procps && rm -rf /var/lib/apt/lists/*

# 从 builder 阶段拷回编译产物 (不含 golang 编译器，镜像更小)
COPY --from=builder /src/webapp /usr/local/bin/webapp
RUN chmod +x /usr/local/bin/webapp

ENV APP_ENV=production
ENV LISTEN_ADDR=:8082

RUN printf '[Unit]\nDescription=Debian Go Multi-stage\nAfter=network.target\n\n[Service]\nType=simple\nEnvironmentFile=/etc/sb_lxc.env\nExecStart=/usr/local/bin/webapp\nRestart=on-failure\nRestartSec=3\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/debian-go.service && \
    systemctl enable debian-go.service

EXPOSE 8082/tcp
DOMAIN debian-go.test
AUTOSTART on
