# Fedora Python - 单 FROM + TEMP 块 (all-in-one 模式)
# 测试点：Fedora 镜像（dnf 包管理）、TEMP 块隔离编译工具链、COPY --from=<块名>
# 测试命令：curl http://fedora-python.test/health
#           curl http://fedora-python.test/
FROM fedora/44
NAME fedora-python

# Fedora 换清华源 + 安装运行时依赖
RUN sed -i 's|^metalink=|#metalink=|g; s|^#baseurl=http://download.example/pub/fedora/linux|baseurl=https://mirrors.tuna.tsinghua.edu.cn/fedora|g' /etc/yum.repos.d/fedora.repo /etc/yum.repos.d/fedora-updates.repo 2>/dev/null || true

RUN dnf install -y python3 python3-pip python3-flask curl procps-ng && dnf clean all

# TEMP 块: 安装 gcc 编译工具链，编译一个无依赖的纯 Python 模块作为标记
# 工具链不会进入最终镜像 (验证 TEMP 隔离)
TEMP builder
  RUN dnf install -y gcc python3-devel
  WORKDIR /build
  RUN printf 'def hello():\n    return "built-in-temp-block"\n' > appmod.py
  RUN python3 -c "import py_compile; py_compile.compile('appmod.py', 'appmod.pyc')"
END

# 从 builder 块拷回编译产物 (验证 COPY --from=<块名>)
RUN mkdir -p /app
COPY --from=builder /build/appmod.py /app/appmod.py
COPY --from=builder /build/appmod.pyc /app/appmod.pyc

COPY ./app.py /app/app.py

ENV FLASK_APP=/app/app.py
ENV APP_MODULE=/app/appmod.py

# 注册 systemd 服务
RUN printf '[Unit]\nDescription=Fedora Python Test\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=/usr/bin/python3 /app/app.py\nWorkingDirectory=/app\nRestart=on-failure\nRestartSec=3\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/fedora-python.service && \
    systemctl enable fedora-python.service

EXPOSE 5000/tcp
DOMAIN fedora-python.test
AUTOSTART on
