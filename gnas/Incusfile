# GNAS - 私有 NAS 服务 (Go + Vue + SQLite)
# 多阶段构建：builder 阶段编译前端+后端，runtime 阶段只含运行时依赖
#
# 为什么用多阶段而非宿主机编译：
#   1. 需要 Go 1.25 (go.mod 要求)，服务器宿主机不一定有
#   2. 需要 Node.js + npm 构建前端，宿主机不一定有
#   3. main.go 用 //go:embed all:web/dist 内嵌前端，必须先构建前端再编译 Go
#   4. 两个工具链都很重，不应污染宿主机

# === 阶段 1: builder (编译前端 + 后端) ===
FROM debian/13 AS builder

# 换清华源加速 apt (debian/13 = trixie)
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 装 Go 1.25 (Debian 13 仓库只有 1.24，不够) + Node.js 22 (构建前端)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Go 1.25 官方二进制 (清华镜像)
RUN curl -fsSL https://golang.google.cn/dl/go1.25.0.linux-amd64.tar.gz | tar -xz -C /usr/local && \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go

# Node.js 22 LTS (清华镜像) + npm 换淘宝源
RUN curl -fsSL https://npmmirror.com/mirrors/node/v22.11.0/node-v22.11.0-linux-x64.tar.xz | tar -xJ -C /usr/local && \
    ln -sf /usr/local/node-v22.11.0-linux-x64/bin/node /usr/local/bin/node && \
    ln -sf /usr/local/node-v22.11.0-linux-x64/bin/npm /usr/local/bin/npm && \
    npm config set registry https://registry.npmmirror.com

WORKDIR /src

# 七牛 Go 模块代理
ENV GOPROXY=https://goproxy.cn
ENV GOSUMDB=off
ENV CGO_ENABLED=0

# 先复制依赖清单，利用层缓存
COPY ./go.mod ./
COPY ./go.sum ./
RUN go mod download

# 复制源码
COPY ./main.go ./
COPY ./internal ./internal

# 构建前端 (产物在 web/dist/)
COPY ./web ./web
RUN cd web && npm ci && npm run build

# 编译后端 (//go:embed all:web/dist 会把前端产物内嵌进二进制)
RUN go build -trimpath -ldflags '-s -w -X main.version=container' -o gnas .

# === 阶段 2: 运行时 ===
FROM debian/13
NAME gnas

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 运行时依赖：
# - ffmpeg: 视频缩略图 (程序运行时会自动调用 apt-get install，但预装避免首次启动卡顿)
# - ca-certificates: HTTPS (七牛/清华源、Ollama 等)
# - procps/curl/net-tools: 调试和健康检查
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ffmpeg ca-certificates curl procps net-tools \
    && rm -rf /var/lib/apt/lists/*

# 数据目录 (程序硬编码 /var/lib/gnas)
RUN mkdir -p /var/lib/gnas

# 从 builder 阶段复制编译产物 (不含 Go/Node.js 工具链，镜像更小)
COPY --from=builder /src/gnas /usr/local/bin/gnas
RUN chmod +x /usr/local/bin/gnas

# 复用项目自带的 systemd 服务文件 (deploy/gnas.service)
COPY ./deploy/gnas.service /etc/systemd/system/gnas.service
RUN systemctl enable gnas.service

EXPOSE 8082/tcp
DOMAIN gnas.test
AUTOSTART on
