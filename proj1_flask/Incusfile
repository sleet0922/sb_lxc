# Flask 网页计数器 - 单阶段构建示例
# Python 是解释型语言，无需多阶段编译，直接装运行时即可
#
# 用法: sb_lxc build
# 测试: curl http://flask.test        (需宿主机 /etc/hosts 已写入域名)
#       curl http://flask.test/api/count
#       curl http://flask.test/health

# ─────────── 基础镜像 ───────────
FROM debian/13
NAME flask-counter

# ─────────── 换清华 Debian 源 (debian/13 = trixie) ───────────
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# ─────────── 安装运行时依赖 ───────────
# python3:            应用运行时
# python3-flask:      系统包自带一份 Flask (兜底，避免 pip 失败时无 Flask 可用)
# python3-pip:        安装 requirements.txt 指定版本
# sqlite3:            命令行工具，方便容器内排查计数数据库
# ca-certificates:    HTTPS 访问 PyPI / 清华源
# curl procps:        健康检查与调试 (curl 调 /health, ps 查进程)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-flask python3-pip sqlite3 ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# ─────────── 应用目录 ───────────
# /app       : 应用代码
# /app/data  : SQLite 数据文件 (counter.db)
RUN mkdir -p /app/data

# ─────────── 复制应用代码 ───────────
COPY ./app.py /app/app.py
COPY ./requirements.txt /app/requirements.txt

# ─────────── 安装 Python 依赖 (清华 PyPI 源) ───────────
# --break-system-packages: Debian 12+ 的 PEP 668 要求, 显式绕过外部包管理保护
RUN pip3 install -r /app/requirements.txt --break-system-packages \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

# ─────────── 注册 systemd 服务 ───────────
# 容器启动后由 systemd 自动拉起 flask-counter 服务
RUN printf '[Unit]\n\
Description=Flask Web Counter\n\
After=network.target\n\
\n\
[Service]\n\
Type=simple\n\
ExecStart=/usr/bin/python3 /app/app.py\n\
WorkingDirectory=/app\n\
Restart=on-failure\n\
RestartSec=3\n\
StandardOutput=journal\n\
StandardError=journal\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' > /etc/systemd/system/flask-counter.service && \
    systemctl enable flask-counter.service

# ─────────── 运行时环境变量 ───────────
ENV FLASK_ENV=production

# ─────────── 运行时配置 ───────────
EXPOSE 5000/tcp
DOMAIN flask.test
AUTOSTART on
