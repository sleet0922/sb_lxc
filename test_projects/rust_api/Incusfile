# === rust_api: Rust 零依赖多阶段构建 ===
# 测试点: Rust 工具链 (apt rustc/cargo)、cargo build --release、
#         跨阶段复制二进制、WORKDIR、ENV、panic=abort 静态二进制

# ─────────── 阶段 1: builder (Rust 编译) ───────────
FROM debian/13 AS builder

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 安装 Rust 工具链 (Debian 13 自带 rustc + cargo)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        cargo rustc ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# 复制源码 (零外部依赖, 不需要 cargo download)
COPY ./Cargo.toml ./
COPY ./src ./src

# cargo build --release (LTO + strip + panic=abort → 极小二进制)
RUN cargo build --release && \
    cp target/release/rust-api /out/rust-api || (mkdir -p /out && cp target/release/rust-api /out/rust-api)

# ─────────── 阶段 2: 运行时 ───────────
FROM debian/13
NAME rust-api

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 运行时依赖 (极简)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制编译产物
COPY --from=builder /out/rust-api /usr/local/bin/rust-api
RUN chmod +x /usr/local/bin/rust-api

# 注册 systemd 服务
RUN printf '[Unit]\n\
Description=Rust API (sb_lxc)\n\
After=network.target\n\
\n\
[Service]\n\
Type=simple\n\
ExecStart=/usr/local/bin/rust-api\n\
Restart=on-failure\n\
RestartSec=3\n\
StandardOutput=journal\n\
StandardError=journal\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' > /etc/systemd/system/rust-api.service && \
    systemctl enable rust-api.service

ENV LISTEN_ADDR=0.0.0.0:8080
ENV APP_VERSION=1.0.0

# ─────────── 运行时配置 ───────────
EXPOSE 8080/tcp
DOMAIN rustapi.test
AUTOSTART on
