# === lamp_stack: Caddy + PHP-FPM + MariaDB 单阶段多服务编排 ===
# 测试点: 单阶段复杂多服务 (3 服务依赖链)、PHP-FPM unix socket、
#         MariaDB 构建时初始化、systemd After/Requires 编排、
#         禁用默认服务避免冲突

# ─────────── 基础镜像 ───────────
FROM debian/13
NAME lamp-stack

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 安装运行时依赖:
# caddy:           Web 服务器 (替代 nginx, 自动 HTTPS)
# php-fpm:         PHP FastCGI 进程管理器
# php-mysql:       PHP MySQL 驱动
# php-json:        PHP JSON 扩展
# mariadb-server:  数据库
# ca-certificates: HTTPS
# curl procps:     健康检查与调试
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        caddy php-fpm php-mysql php-json \
        mariadb-server ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# 创建应用目录 (caddy 不自动创建 /var/www/html)
RUN mkdir -p /var/www/html /app /etc/caddy /var/log/caddy

# 复制应用代码和配置
COPY ./index.php /var/www/html/index.php
COPY ./Caddyfile /etc/caddy/Caddyfile
COPY ./init.sql /app/init.sql

# 初始化 MariaDB (构建时执行)
RUN service mariadb start && \
    mysql < /app/init.sql && \
    service mariadb stop

# ─────────── 禁用默认服务 (避免冲突) ───────────
# apt 装的 caddy 会注册默认 caddy.service 并 enable
# 我们要用自定义 Caddyfile, 禁用默认服务
RUN systemctl disable caddy.service 2>/dev/null || true

# ─────────── 注册 systemd 服务 (3 服务依赖链) ───────────

# 服务 1: MariaDB (用系统自带 mariadb.service)
RUN systemctl enable mariadb.service

# 服务 2: PHP-FPM (Debian 13 的服务名为 php8.4-fpm.service)
# 确保 PHP-FPM socket 目录存在
RUN mkdir -p /run/php && systemctl enable php8.4-fpm.service

# 服务 3: Caddy (自定义服务, 依赖 MariaDB + PHP-FPM)
RUN printf '[Unit]\n\
Description=LAMP Stack Caddy (sb_lxc)\n\
After=network.target mariadb.service php8.4-fpm.service\n\
Requires=mariadb.service php8.4-fpm.service\n\
\n\
[Service]\n\
Type=simple\n\
ExecStartPre=/usr/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile\n\
ExecStart=/usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile\n\
Restart=on-failure\n\
RestartSec=3\n\
StandardOutput=journal\n\
StandardError=journal\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' > /etc/systemd/system/lamp-stack.service && \
    systemctl enable lamp-stack.service

# ─────────── 运行时配置 ───────────
ENV APP_ENV=production
EXPOSE 80/tcp
DOMAIN lamp.test
AUTOSTART on
