# === go_fullstack: Go + embed.FS 多阶段构建 ===
# 测试点: FROM AS builder、WORKDIR 多次设置、COPY --from=、ENV KEY=VALUE、
#         RUN 多行续行、go build 静态编译、//go:embed 内嵌资源

# ─────────── 阶段 1: builder (Go 编译) ───────────
FROM debian/13 AS builder

# 换清华源 (debian/13 = trixie)
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 安装编译工具链: golang-go (Debian 13 自带 Go 1.23)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        golang-go ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Go 模块代理 (七牛)
ENV GOPROXY=https://goproxy.cn
ENV GOSUMDB=off
ENV CGO_ENABLED=0

# 先复制依赖清单 (利用层缓存)
COPY ./go.mod ./

# 复制源码 (含内嵌的 web/dist/)
COPY ./main.go ./
COPY ./web ./web

# 编译纯静态二进制
RUN mkdir -p /out && go build -trimpath -ldflags '-s -w -X main.version=v1.0.0' -o /out/go-fullstack .

# ─────────── 阶段 2: 运行时 ───────────
FROM debian/13
NAME go-fullstack

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 运行时依赖 (极简: 纯静态二进制只需 ca-certificates + curl)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制编译产物
COPY --from=builder /out/go-fullstack /usr/local/bin/go-fullstack
RUN chmod +x /usr/local/bin/go-fullstack

# 注册 systemd 服务
RUN printf '[Unit]\n\
Description=Go Fullstack Todo API (sb_lxc)\n\
After=network.target\n\
\n\
[Service]\n\
Type=simple\n\
ExecStart=/usr/local/bin/go-fullstack\n\
Restart=on-failure\n\
RestartSec=3\n\
StandardOutput=journal\n\
StandardError=journal\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' > /etc/systemd/system/go-fullstack.service && \
    systemctl enable go-fullstack.service

ENV LISTEN_ADDR=:8080
ENV APP_VERSION=1.0.0

# ─────────── 运行时配置 ───────────
EXPOSE 8080/tcp
DOMAIN gofull.test
AUTOSTART on
