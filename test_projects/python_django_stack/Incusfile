# === python_django_stack: Flask + Redis + MariaDB 多阶段构建 ===
# 测试点: venv 跨阶段复制、3 服务 systemd 编排 (mariadb→redis→flask)、
#         ENV KEY VALUE 格式 (不带等号)、EXPOSE 多端口、COPY 目录

# ─────────── 阶段 1: builder (venv 安装 Python 依赖) ───────────
FROM debian/13 AS builder

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 安装 Python venv + pip
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 创建 venv 并升级 pip (清华 PyPI 源)
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

# 安装依赖到 venv
COPY ./requirements.txt /build/requirements.txt
RUN /opt/venv/bin/pip install -r /build/requirements.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

# ─────────── 阶段 2: 运行时 (3 服务编排) ───────────
FROM debian/13
NAME py-flask-stack

# 换清华源
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && \
    printf 'deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware\n\
deb https://mirrors.tuna.tsinghua.edu.cn/debian-security/ trixie-security main contrib non-free non-free-firmware\n' \
    > /etc/apt/sources.list

# 运行时依赖: python3 (运行 venv) + redis-server + mariadb-server + curl/procps
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 redis-server mariadb-server ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制 venv
COPY --from=builder /opt/venv /opt/venv

# 应用目录
RUN mkdir -p /app

# 复制应用代码
COPY ./app.py /app/app.py
COPY ./init.sql /app/init.sql

# 让 venv 的 python 优先 (ENV KEY VALUE 格式 — 不带等号)
ENV PATH /opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 初始化 MariaDB 数据库和用户
RUN service mariadb start && \
    mysql < /app/init.sql && \
    service mariadb stop

# ─────────── 注册 systemd 服务 (3 服务编排) ───────────

# 服务 1: MariaDB (用系统自带 mariadb.service)
RUN systemctl enable mariadb.service

# 服务 2: Redis (自定义服务, 禁用 systemd sandbox — 容器内不支持 mount namespace)
# Debian 13 的 redis-server.service 使用 ProtectHome/PrivateTmp 等安全特性, 在 Incus 容器内会失败
# 改用自定义服务直接运行 redis-server --daemonize no
RUN systemctl disable redis-server.service 2>/dev/null || true; \
    printf '[Unit]\nDescription=Redis Custom (sb_lxc)\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=/usr/bin/redis-server /etc/redis/redis.conf --daemonize no\nRestart=on-failure\nRestartSec=3\n\n[Install]\nWantedBy=multi-user.target\n' \
    > /etc/systemd/system/redis-custom.service && \
    systemctl enable redis-custom.service

# 服务 3: Flask 应用 (依赖 MariaDB + Redis)
RUN printf '[Unit]\n\
Description=Flask + Redis + MariaDB Stack (sb_lxc)\n\
After=network.target mariadb.service redis-custom.service\n\
Requires=mariadb.service redis-custom.service\n\
\n\
[Service]\n\
Type=simple\n\
ExecStart=/opt/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 app:app\n\
WorkingDirectory=/app\n\
Environment=REDIS_HOST=127.0.0.1\n\
Environment=REDIS_PORT=6379\n\
Environment=DB_HOST=127.0.0.1\n\
Environment=DB_PORT=3306\n\
Environment=DB_USER=appuser\n\
Environment=DB_PASS=apppass\n\
Environment=DB_NAME=appdb\n\
Restart=on-failure\n\
RestartSec=5\n\
StandardOutput=journal\n\
StandardError=journal\n\
\n\
[Install]\n\
WantedBy=multi-user.target\n' > /etc/systemd/system/py-flask-stack.service && \
    systemctl enable py-flask-stack.service

# 环境变量 (ENV KEY VALUE 格式 — 测试不带等号的写法)
ENV FLASK_ENV production
ENV REDIS_HOST 127.0.0.1
ENV DB_HOST 127.0.0.1

# ─────────── 运行时配置 ───────────
EXPOSE 5000/tcp
DOMAIN pyflask.test
AUTOSTART on
